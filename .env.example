# Supabase
# Ambil nilainya dari Supabase Dashboard > Project Settings > API.
# Salin file ini menjadi `.env` lalu isi dengan nilai aslimu. JANGAN commit `.env`.

# URL project, contoh: https://abcdefghijklm.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# Kunci publik / anon - aman untuk dikirim ke browser.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Kunci service_role - HANYA untuk server. Jangan pernah ditaruh di kode frontend
# dan jangan pernah di-commit ke repository.
SUPABASE_SERVICE_ROLE_KEY=

# Opsional. Tanpa ini, asisten AI menampilkan "belum dikonfigurasi" dan fitur
# AI tetap bisa dinonaktifkan tanpa error.
LOVABLE_API_KEY=

# Opsional. Dipakai untuk endpoint cron terjadwal.
LOVABLE_CRON_SECRET=